{
  "description": "坏数据测试：每条从 base_clean.v2.json 出发，按 ops 改坏一处，pas check 必须报出 expect 里的不变量 ID；base_clean.v2.json 本身必须没有 error。ops 用 RFC 6902 的子集：add、replace、remove，path 为 JSON Pointer。",
  "base": "base_clean.v2.json",
  "tests": [
    {"id": "P-SC-01", "about": "schema：缺必填字段", "ops": [{"op": "remove", "path": "/problem/success_test"}], "expect": ["SCHEMA"]},
    {"id": "P-SC-02", "about": "schema：非法枚举", "ops": [{"op": "replace", "path": "/constraints/0/kind", "value": "maybe"}], "expect": ["SCHEMA"]},
    {"id": "P-SC-03", "about": "schema：未知字段", "ops": [{"op": "add", "path": "/problem/answer", "value": "就选 Kikoff"}], "expect": ["SCHEMA"]},
    {"id": "P-CO-01", "about": "ID 重复", "ops": [{"op": "replace", "path": "/evidence/1/id", "value": "E1"}], "expect": ["CO-01"]},
    {"id": "P-CO-02", "about": "验证指向不存在的对象", "ops": [{"op": "replace", "path": "/verifications/0/target", "value": "N99"}], "expect": ["CO-05"]},
    {"id": "P-CO-03", "about": "成功检验是'用户满意'", "ops": [{"op": "replace", "path": "/problem/success_test", "value": "用户满意就行"}], "expect": ["CO-03"]},
    {"id": "P-CO-04", "about": "轮次不递增", "ops": [{"op": "replace", "path": "/rounds/2/n", "value": 2}], "expect": ["CO-11"]},
    {"id": "P-VF-01", "about": "失败没写原因", "ops": [{"op": "remove", "path": "/verifications/0/cause"}], "expect": ["VF-01"]},
    {"id": "P-VF-02", "about": "原因是漏约束却没写违反的约束", "ops": [{"op": "remove", "path": "/verifications/1/violated"}], "expect": ["VF-02"]},
    {"id": "P-VF-03", "about": "回归指向未通过的验证", "ops": [{"op": "add", "path": "/verifications/2/regression_of", "value": ["V1"]}], "expect": ["VF-04"]},
    {"id": "P-TM-01", "about": "决策之后才知道的证据被用来支持当时的决策", "ops": [{"op": "replace", "path": "/evidence/1/observed_at", "value": "2026-10-20"}], "expect": ["TM-01"]},
    {"id": "P-AR-01", "about": "接受的母题没写结构检查", "ops": [{"op": "remove", "path": "/archetypes/1/structural_checks"}], "expect": ["AR-02"]},
    {"id": "P-AR-02", "about": "母题指向不存在的工作结构定义", "ops": [{"op": "replace", "path": "/archetypes/0/workbench", "value": "no_such_structure"}], "expect": ["AR-03"]},
    {"id": "P-AR-03", "about": "弃用母题没写原因", "ops": [{"op": "replace", "path": "/archetypes/2/status", "value": "rejected"}], "expect": ["AR-04"]},
    {"id": "P-WB-01", "about": "工作结构类型没有定义文件", "ops": [{"op": "replace", "path": "/workbenches/2/type", "value": "mystery"}], "expect": ["WB-01"]},
    {"id": "P-WB-02", "about": "节点 kind 不在定义里", "ops": [{"op": "replace", "path": "/workbenches/0/nodes/1/kind", "value": "wish"}], "expect": ["WB-02"]},
    {"id": "P-WB-03", "about": "节点状态不在定义里", "ops": [{"op": "replace", "path": "/workbenches/1/nodes/0/status", "value": "pruned"}], "expect": ["WB-03"]},
    {"id": "P-WB-04", "about": "边类型不在定义里", "ops": [{"op": "add", "path": "/workbenches/2/edges/-", "value": {"from": "CL1", "to": "CL1", "type": "contradicts"}}], "expect": ["WB-04"]},
    {"id": "P-CT-01", "about": "候选树两个根", "ops": [{"op": "replace", "path": "/workbenches/0/nodes/4/parent", "value": null}], "expect": ["CT-01"]},
    {"id": "P-CT-02", "about": "节点引用不存在的证据", "ops": [{"op": "replace", "path": "/workbenches/0/nodes/5/evidence", "value": ["E9"]}], "expect": ["CT-02"]},
    {"id": "P-CT-03", "about": "淘汰没写 pruned_by", "ops": [{"op": "replace", "path": "/workbenches/0/nodes/7/pruned_by", "value": []}], "expect": ["CT-03"]},
    {"id": "P-CT-04", "about": "软偏好淘汰", "ops": [{"op": "replace", "path": "/workbenches/0/nodes/6/status", "value": "pruned"}, {"op": "add", "path": "/workbenches/0/nodes/6/pruned_by", "value": ["C4"]}], "expect": ["CT-04"]},
    {"id": "P-CT-05", "about": "未确认的硬约束淘汰", "ops": [{"op": "replace", "path": "/constraints/4/verified", "value": false}], "expect": ["CT-05"]},
    {"id": "P-CT-06", "about": "外部事实约束没有已核实证据却用于淘汰", "ops": [{"op": "replace", "path": "/evidence/1/verified", "value": false}], "expect": ["CT-06", "CT-07"]},
    {"id": "P-CT-07", "about": "淘汰用了未核实的证据", "ops": [{"op": "add", "path": "/evidence/-", "value": {"id": "E3", "claim": "论坛说该行不收", "type": "fact", "source": "论坛帖子", "verified": false}}, {"op": "replace", "path": "/workbenches/0/nodes/7/evidence", "value": ["E3"]}], "expect": ["CT-07"]},
    {"id": "P-CT-08", "about": "搁置没写原因", "ops": [{"op": "replace", "path": "/workbenches/0/nodes/6/parked_by", "value": []}, {"op": "remove", "path": "/workbenches/0/nodes/6/park_reference"}], "expect": ["CT-08"]},
    {"id": "P-CT-11", "about": "已解决但选定方案没有通过的验证", "ops": [{"op": "replace", "path": "/status", "value": "solved"}, {"op": "replace", "path": "/verifications/2/result", "value": "pending"}], "expect": ["CT-11"]},
    {"id": "P-CT-15", "about": "同层两个失败没提冲突核（只检查规则提醒）", "ops": [{"op": "replace", "path": "/conflicts", "value": []}], "expect": ["CT-15"]},
    {"id": "P-CT-16", "about": "全部出局仍有搁置项（只检查规则提醒）", "ops": [{"op": "replace", "path": "/workbenches/0/nodes/5/status", "value": "failed"}, {"op": "add", "path": "/workbenches/0/nodes/5/note", "value": "测试"}, {"op": "replace", "path": "/workbenches/0/nodes/4/status", "value": "failed"}, {"op": "add", "path": "/workbenches/0/nodes/4/note", "value": "测试"}, {"op": "replace", "path": "/workbenches/0/nodes/0/status", "value": "failed"}, {"op": "add", "path": "/workbenches/0/nodes/0/note", "value": "测试"}, {"op": "replace", "path": "/status", "value": "open"}], "expect": ["CT-16"]},
    {"id": "P-DG-01", "about": "依赖环没标出", "ops": [{"op": "replace", "path": "/workbenches/1/extra/cycles", "value": []}], "expect": ["DG-01"]},
    {"id": "P-DG-02", "about": "中继依赖环里的东西", "ops": [{"op": "add", "path": "/workbenches/1/edges/-", "value": {"from": "G3", "to": "G1", "type": "requires"}}], "expect": ["DG-02"]},
    {"id": "P-DT-02", "about": "情景概率之和超过 1", "ops": [{"op": "add", "path": "/workbenches/-", "value": {"id": "W4", "type": "decision_tree", "type_version": 1, "nodes": [{"id": "T1", "kind": "choice", "status": "open", "parent": null, "label": "要不要办", "reversible": true}, {"id": "T2", "kind": "scenario", "status": "open", "parent": "T1", "label": "获批", "p": 0.7}, {"id": "T3", "kind": "scenario", "status": "open", "parent": "T1", "label": "被拒", "p": 0.6}], "edges": []}}], "expect": ["DT-02"]},
    {"id": "P-AG-04", "about": "有效论断带撤回记录", "ops": [{"op": "add", "path": "/workbenches/2/nodes/0/withdrawal", "value": {"date": "2026-10-20", "root_cause": "测试", "scope": "proof"}}], "expect": ["AG-04"]},
    {"id": "P-AG-05", "about": "自评独立（检验者就是提出者）", "ops": [{"op": "replace", "path": "/verifications/3/result", "value": "pass"}, {"op": "add", "path": "/verifications/3/independent", "value": true}, {"op": "add", "path": "/verifications/3/by", "value": "ai"}], "expect": ["AG-05"]},
    {"id": "P-AG-06", "about": "上游撤回后下游未处理（只检查规则提醒）", "ops": [{"op": "add", "path": "/workbenches/2/nodes/-", "value": {"id": "CL2", "kind": "claim", "status": "current", "statement": "因此不需要备选方案"}}, {"op": "add", "path": "/workbenches/2/edges/-", "value": {"from": "CL2", "to": "CL1", "type": "depends_on", "edge": "conclusion"}}, {"op": "replace", "path": "/workbenches/2/nodes/0/status", "value": "withdrawn"}, {"op": "add", "path": "/workbenches/2/nodes/0/withdrawal", "value": {"date": "2026-10-20", "root_cause": "测试", "scope": "statement"}}], "expect": ["AG-06"]},
    {"id": "P-AG-08", "about": "预测过了结算日没结算（只检查规则提醒）", "ops": [{"op": "replace", "path": "/workbenches/2/nodes/0/prediction/settle_by", "value": "2026-10-15"}], "expect": ["AG-08"]},
    {"id": "P-FP-01", "about": "快速通道没写理由", "ops": [{"op": "add", "path": "/problem/fast_path", "value": {"reason": ""}}], "expect": ["SCHEMA"]}
  ]
}
